# NestJS API (repo root). Copy to .env.
PORT=4000
WEB_ORIGIN=http://localhost:3001
PUBLIC_API_URL=http://localhost:4000

# Supabase project settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on legacy HS256 JWT secrets; leave empty to use JWKS.
SUPABASE_JWT_SECRET=

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Food Fusion custom voice (must be allowed under Agent → Security → Overrides).
# ELEVENLABS_VOICE_ID is retained for existing deployments.
ELEVENLABS_GHALIB_VOICE_ID=YOUR_FOOD_FUSION_GHALIB_VOICE_ID
ELEVENLABS_VOICE_ID=
# "true" sends dish words (Peshawari, Karahi, Malai…) as ASR keywords to cut mishearing.
ELEVENLABS_BOOST_MENU_KEYWORDS=true

# n8n customer-feedback workflow (use /webhook, not /webhook-test, in production)
N8N_FEEDBACK_WEBHOOK_URL=https://YOUR_N8N_INSTANCE_URL/webhook/api/v1/restaurant/feedback
# n8n order-completed workflow (receipt / thank-you email); empty = disabled
N8N_ORDER_WEBHOOK_URL=https://YOUR_N8N_INSTANCE_URL/webhook/api/v1/restaurant/order-completed
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string
